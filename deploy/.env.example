# Copy to deploy/.env and edit. Every value has a default; an empty file works locally.

# Your domain (its DNS A record must point at this server) → automatic HTTPS.
# Leave as :80 to serve plain http://localhost (local testing).
DOMAIN=:80

# Biggest upload in MB, and the matching proxy limit (a little more, for the form envelope).
MAX_MB=100
BODY_MAX=130MB
# Leftover job files are deleted after this many minutes (each job's files go as soon as it ends).
RETENTION_MIN=60
# Requests per IP address.
RATE_LIMIT=30/minute
# Conversions running at once (empty = number of CPU cores).
CONCURRENCY=
# Other sites allowed to call this API, comma-separated (e.g. the GitHub Pages copy):
# CORS_ORIGINS=https://micro4tricks-ai.github.io
CORS_ORIGINS=

# Professional translation with Claude (optional; the free translation runs in the browser).
# Get a key at https://console.anthropic.com — usage is billed to that account.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
# Most characters translated per day (all visitors together), to cap the bill.
PRO_DAILY_CHARS=300000
