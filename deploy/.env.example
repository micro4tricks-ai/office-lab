# Copy to deploy/.env and edit. Every value has a default; an empty file works locally.

# Your domain (its DNS A record must point at this server) → automatic HTTPS.
# Leave as :80 to serve plain http://localhost (local testing).
DOMAIN=:80
# The site's public address, for search engines and link previews (sitemap, canonical links).
# install-vps.sh fills it in from DOMAIN. Empty = left out.
SITE_ORIGIN=

# Biggest upload in MB, and the matching proxy limit (a little more, for the form envelope).
MAX_MB=100
BODY_MAX=130MB
# Leftover job files are deleted after this many minutes (each job's files go as soon as it ends).
RETENTION_MIN=60
# Requests per IP address.
RATE_LIMIT=30/minute
# API keys for other programs (the site itself needs none). Make one with:
#   docker compose exec api python -m app.keys new office-name
# and paste the printed "name:hash" here (comma-separated). Requests send
# "Authorization: Bearer olab_..." and get their own limit, per key.
API_KEYS=
KEY_RATE_LIMIT=120/minute
# Conversions running at once (empty = number of CPU cores). Sharing the server with
# another app? Use 2 and keep the memory caps below (deploy/HOSTINGER.md §9).
CONCURRENCY=
# Memory caps for the converters (FFmpeg ~400 MB per video, LibreOffice up to ~1 GB per big file).
API_MEM=2g
GOTENBERG_MEM=2g
# Ports. Another proxy (Traefik, nginx, a second Caddy) already owns 80/443? Then e.g.
# HTTP_PORT=127.0.0.1:8080 and HTTPS_PORT=127.0.0.1:8443, keep DOMAIN=:80, and point that proxy at 8080.
HTTP_PORT=80
HTTPS_PORT=443
# Other sites allowed to call this API, comma-separated (e.g. the GitHub Pages copy):
# CORS_ORIGINS=https://micro4tricks-ai.github.io
CORS_ORIGINS=

# Professional translation with Claude (optional; the free translation runs in the browser).
# Get a key at https://console.anthropic.com — usage is billed to that account.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
# Most characters translated per day (all visitors together), to cap the bill.
PRO_DAILY_CHARS=300000
