		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/jxl": "^1.3.0",
		"@jsquash/oxipng": "^2.3.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/webp": "^1.5.0",
		"@mediabunny/aac-encoder": "^1.61.3",
		"@mediabunny/mp3-encoder": "^1.61.3",
		"@pdf-lib/fontkit": "^1.1.1",
