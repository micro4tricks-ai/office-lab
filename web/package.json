{
	"name": "office-lab-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"precheck": "node scripts/copy-assets.mjs",
		"predev": "node scripts/copy-assets.mjs && node scripts/fetch-models.mjs",
		"prebuild": "node scripts/copy-assets.mjs && node scripts/fetch-models.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "vitest run && playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
