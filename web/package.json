		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"@types/turndown": "^5.0.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "^2.11.1",
		"@fontsource-variable/cairo": "^5.3.0",
		"@fontsource/amiri": "^5.3.0",
